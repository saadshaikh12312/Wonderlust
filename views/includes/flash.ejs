<% if ( success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show col-md-4 position-fixed top-2 end-0 z-2 me-4  flash flash-success" role="alert">
  <span>
    <%= success %>
  </span>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if ( error && error.length) { %>
<div class="alert alert-danger alert-dismissible fade show col-md-4 position-fixed top-2 end-0 z-2 me-4 flash flash-danger" role="alert">
  <span>
    <%= error %>
  </span>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>